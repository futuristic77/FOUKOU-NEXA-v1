# Connexion PostgreSQL (obligatoire). Ne jamais committer la valeur réelle.
DATABASE_URL=postgresql://user:password@host:5432/database
# Utiliser "disable" uniquement pour une instance locale sans TLS.
DATABASE_SSL=require
# Désactive la télémétrie du CLI Next.js lors des builds.
NEXT_TELEMETRY_DISABLED=1

# Amorçage optionnel, uniquement avec `pnpm db:migrate`.
SEED_SCHOOL_NAME=Nom de votre établissement
SEED_ADMIN_EMAIL=direction@example.org
# 12 caractères minimum. Laisser vide après le premier amorçage.
SEED_ADMIN_PASSWORD=
