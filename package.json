    "db:migrate": "node scripts/migrate.mjs --target=non-production",
    "db:migrate:production": "node scripts/migrate.mjs --target=production",
    "db:bootstrap:super-admin": "node scripts/bootstrap-super-admin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
