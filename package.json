    "test:unit": "node --test tests/account-guards.test.mjs tests/action-audit-contract.test.mjs tests/database-target-guard.test.mjs tests/login-rate-limit-contract.test.mjs tests/migration-static.test.mjs tests/security.test.mjs tests/school-admin-contract.test.mjs tests/school-calculations.test.mjs tests/test-database-guard.test.mjs",
